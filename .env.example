# Optional. If present, the CLI will try to generate a markdown note.
OPENAI_API_KEY=

# Optional. Used only when OPENAI_API_KEY is set.
OPENAI_MODEL=gpt-4.1-mini

# Optional comma-separated transcript language preferences.
YOUTUBE_TRANSCRIPT_LANGUAGES=en

# Optional output root for installed CLI usage when --output-dir is not provided.
YNN_OUTPUT_DIR=

# Optional for local/manual usage. Required for --export notion and the manual Notion smoke test.
NOTION_API_KEY=
NOTION_DATABASE_ID=
